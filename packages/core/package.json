{
  "name": "@the-thing/core",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./context-budget": {
      "types": "./src/services/context/budget-schema.ts",
      "default": "./src/services/context/budget-schema.ts"
    }
  },
  "scripts": {
    "typecheck": "pnpm check:skills-generated && tsc --noEmit",
    "test": "pnpm check:skills-generated && vitest run",
    "test:watch": "vitest",
    "generate:skills": "node scripts/generate-bundled-skills.mjs",
    "check:skills-generated": "node scripts/generate-bundled-skills.mjs --check",
    "check:circular": "npx madge --circular --extensions ts ./src",
    "check:layers": "node scripts/check-layer-deps.mjs",
    "check:interfaces": "node scripts/check-interface-isolation.mjs",
    "check:exports": "node scripts/check-export-surface.mjs"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.29",
    "@ai-sdk/openai-compatible": "^3.0.1",
    "@ai-sdk/provider": "^4.0.7",
    "@larksuiteoapi/node-sdk": "^1.66.0",
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^7.0.65",
    "better-sqlite3": "^12.8.0",
    "fast-check": "^4.9.0",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "js-tiktoken": "^1.0.21",
    "js-yaml": "^4.1.0",
    "minimatch": "^10.2.5",
    "nanoid": "^5.1.7",
    "undici": "^8.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^20",
    "@typescript/native": "npm:typescript@^7.0.2",
    "tsx": "^4.21.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^3.0.0"
  }
}